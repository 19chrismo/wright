{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan graph (procedural lock state machine)",
  "type": "object",
  "required": [
    "id",
    "version",
    "start",
    "states"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terminal": {
            "type": "boolean"
          },
          "exit_guard": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
